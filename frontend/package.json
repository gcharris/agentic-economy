{
  "name": "agentic-economy-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Agentic Economy frontend: Vite + TypeScript + Three.js on WebGL2. Renders StateView and EngineEvent, never simulates. Laboratory artefact (see ../LABORATORY.md).",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:dom": "vitest run --project dom",
    "test:gpu": "playwright test",
    "copy-assets": "node scripts/copy-assets.ts",
    "synth-city": "node scripts/synth-city.ts"
  },
  "dependencies": {
    "maath": "^0.10.8",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.18.0",
    "@types/three": "0.186.0",
    "jsdom": "^27.0.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vite-plugin-glsl": "^1.6.1",
    "vitest": "^3.2.7"
  }
}
